<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='tactile_stick'>
    
    <link name="end_eff">
      <pose>0 0 0.1075 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.001529</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001361</iyy><iyz>0</iyz><izz>0.000448</izz>
        </inertia>
      </inertial>
      <collision name="end_eff_collision">
        <geometry><cylinder><radius>0.02</radius><length>0.215</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>2.0</mu><mu2>2.0</mu2><slip1>0.1</slip1><slip2>0.1</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="end_eff_visual">
        <geometry><cylinder><radius>0.02</radius><length>0.215</length></cylinder></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
        <cast_shadows>false</cast_shadows>
      </visual>
      <gravity>1</gravity>
      <velocity_decay><linear>0.2</linear><angular>0.2</angular></velocity_decay>
      <self_collide>0</self_collide>
    </link>

    <link name="end_eff_sens">
      <pose>0 0 0.22 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>0.000001461</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001461</iyy><iyz>0</iyz><izz>0.000001461</izz>
        </inertia>
      </inertial>
      <collision name="end_eff_sens_collision">
        <geometry><box><size>0.3 0.3 0.01</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>0.6</mu><mu2>0.6</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000</kp><kd>10000</kd><max_vel>0.02</max_vel>
              <min_depth>0.0005</min_depth><soft_cfm>0</soft_cfm><soft_erp>0</soft_erp>
            </ode>
          </contact>
          <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1000</threshold></bounce>
        </surface>
      </collision>
      <visual name="end_eff_sens_visual">
        <geometry><box><size>0.3 0.3 0.01</size></box></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Blue</name>
          </script>
        </material>
        <cast_shadows>false</cast_shadows>
      </visual>
      <gravity>1</gravity>
      <velocity_decay><linear>0.2</linear><angular>0.2</angular></velocity_decay>
      <self_collide>0</self_collide>
      <sensor name="contact_tl" type="contact">
        <always_on>1</always_on>
        <visualize>1</visualize>
        <update_rate>100</update_rate>
        <contact><collision>end_eff_sens_collision</collision></contact>
      </sensor>
    </link>

    <joint name="end_eff_sens_joint" type="fixed">
      <parent>end_eff</parent>
      <child>end_eff_sens</child>
      <sensor type="force_torque" name="force_torque_sensor">
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque</topic> 
        <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque">
          <force_x_noise_mean>0</force_x_noise_mean><force_x_noise_stddev>0.005</force_x_noise_stddev>
          <force_y_noise_mean>0</force_y_noise_mean><force_y_noise_stddev>0.005</force_y_noise_stddev>
          <force_z_noise_mean>0</force_z_noise_mean><force_z_noise_stddev>0.005</force_z_noise_stddev>
          <torque_x_noise_mean>0</torque_x_noise_mean><torque_x_noise_stddev>0.0005</torque_x_noise_stddev>
          <torque_y_noise_mean>0</torque_y_noise_mean><torque_y_noise_stddev>0.0005</torque_y_noise_stddev>
          <torque_z_noise_mean>0</torque_z_noise_mean><torque_z_noise_stddev>0.0005</torque_z_noise_stddev>
        </plugin>
      </sensor>
    </joint>
  </model>
</sdf>
